# Required - your own personal OpenAI key, not a corporate-issued one,
# since this is personal interview prep.
OPENAI_API_KEY=sk-...

# Optional - override the model / temperature used by BOTH paths.
MODEL_NAME=gpt-3.5-turbo
MODEL_TEMPERATURE=0.7

# Optional but recommended - LangSmith tracing. NeMo Guardrails picks these
# up automatically, no code changes needed.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=airline-guardrails-demo

# Workaround only - disables SSL certificate verification for API calls.
# Only set to true on a network you already trust (e.g. your own company's
# proxy on your own company's laptop). The proper fix is installing your
# corporate root CA - see the README's SSL section. Leave as false/unset
# unless you've hit a corporate-proxy SSL error you can't otherwise resolve.
DISABLE_SSL_VERIFY=false
